{
  "appId": "com.baitalkabsa.app",
  "appName": "بيت الكبسة",
  "webDir": "www",
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#3b2415"
  },
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1400,
      "backgroundColor": "#3b2415",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#3b2415"
    }
  }
}
